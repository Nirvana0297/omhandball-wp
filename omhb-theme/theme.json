{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "780px", "wideSize": "1160px" },
    "color": {
      "custom": true,
      "palette": [
        { "slug": "rouge", "color": "#cc1517", "name": "Rouge OMHB" },
        { "slug": "rouge-fonce", "color": "#9f1012", "name": "Rouge foncé" },
        { "slug": "anthracite", "color": "#16181d", "name": "Anthracite" },
        { "slug": "blanc", "color": "#ffffff", "name": "Blanc" },
        { "slug": "gris-clair", "color": "#f5f6f8", "name": "Gris clair" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "slug": "small", "size": "15px", "name": "Petit" },
        { "slug": "medium", "size": "17px", "name": "Normal" },
        { "slug": "large", "size": "24px", "name": "Grand" },
        { "slug": "x-large", "size": "36px", "name": "Très grand" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#33373d" },
    "typography": { "lineHeight": "1.65" },
    "blocks": {
      "core/button": {
        "color": { "background": "#cc1517", "text": "#ffffff" },
        "border": { "radius": "999px" }
      }
    }
  }
}
